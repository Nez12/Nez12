class Car:
    def __init__(self, brand, model, year):
        self.brand = brand
        self.model = model
        self.year = year

    def display_info(self):
        print(f"{self.year} {self.brand} {self.model}")

# Creating car objects
car1 = Car("Toyota", "Supra", 1989)
car2 = Car("Honda", "Nsx", 1995)

# Displaying car details
car1.display_info()
car2.display_info()
